<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;net472</TargetFrameworks>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup>
        <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
    </PropertyGroup>

    <!-- Microsoft.Extensions.* 11.x supports net10.0+ only, so net8.0/net9.0 use 10.x. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
        <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\CarrotMQ.Core\.editorconfig" Link=".editorconfig" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="meziantou.analyzer" Version="3.0.325">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Include="MSTest" Version="4.5.3" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CarrotMQ.Core\CarrotMQ.Core.csproj" />
    </ItemGroup>

</Project>